# Package identity. cimipkg resolves ${NAME} placeholders from this file first,
# then from process environment variables. Set these to your organization's values
# so packages keep a stable identity across builds; an unset PACKAGE_ID_PREFIX
# leaves the literal placeholder in the identifier, which is deliberately loud.
PACKAGE_ID_PREFIX=com.github.windowsadmins
PACKAGE_DEVELOPER=Windows Admins Open Source
