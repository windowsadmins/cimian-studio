<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CimianStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Column 3 historically held a title-bar icon; removed by user request. -->


            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Click="OnBackClicked"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="36" Height="32"
                    Margin="0,0,2,0"
                    IsEnabled="False">
                <Viewbox Width="14" Height="14">
                    <Path Width="24" Height="24" Style="{StaticResource LucidePath}" Data="M12,19 L5,12 L12,5 M19,12 L5,12" />
                </Viewbox>
                <ToolTipService.ToolTip>
                    <TextBlock Text="Back" />
                </ToolTipService.ToolTip>
            </Button>
            <Button x:Name="ForwardButton"
                    Grid.Column="2"
                    Click="OnForwardClicked"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="36" Height="32"
                    Margin="0,0,8,0"
                    IsEnabled="False">
                <Viewbox Width="14" Height="14">
                    <Path Width="24" Height="24" Style="{StaticResource LucidePath}" Data="M5,12 L19,12 M12,5 L19,12 L12,19" />
                </Viewbox>
                <ToolTipService.ToolTip>
                    <TextBlock Text="Forward" />
                </ToolTipService.ToolTip>
            </Button>

            <TextBlock x:Name="AppTitleText"
                       Grid.Column="4"
                       Text="CimianStudio"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="0,0,140,0">
                <Button x:Name="SaveAllButton"
                        Visibility="Collapsed"
                        Click="OnSaveAllClicked"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Path Width="24" Height="24" Style="{StaticResource LucidePath}"
                                  Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                  Data="M19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H16 L21,8 V19 A2,2 0 0 1 19,21 Z M17,21 V13 H7 V21 M7,3 V8 H15" />
                        </Viewbox>
                        <TextBlock x:Name="SaveAllText"
                                   Text="Save all"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ToolTipService.ToolTip>
                        <TextBlock x:Name="SaveAllTooltip" Text="Save all pending edits to disk" />
                    </ToolTipService.ToolTip>
                </Button>
                <TextBlock x:Name="RepoTitleText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="360" />
                <Border x:Name="GitIndicator"
                        Visibility="Collapsed"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2,8,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Path Width="24" Height="24" Style="{StaticResource LucidePath}"
                                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                  Data="M6,3 V15 M15,6 A3,3 0 1 0 21,6 A3,3 0 1 0 15,6 Z M3,18 A3,3 0 1 0 9,18 A3,3 0 1 0 3,18 Z M18,9 A9,9 0 0 1 9,18" />
                        </Viewbox>
                        <TextBlock x:Name="GitBranchText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="GitAheadBehindText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ToolTipService.ToolTip>
                        <TextBlock x:Name="GitIndicatorTooltip" />
                    </ToolTipService.ToolTip>
                </Border>
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="48"
            OpenPaneLength="240"
            Loaded="OnNavViewLoaded"
            SelectionChanged="NavView_SelectionChanged">

            <muxc:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </muxc:NavigationView.Resources>

            <muxc:NavigationView.MenuItems>
                <!-- All nav rail icons are Lucide font glyphs rendered via FontIcon.
                     FontIcon natively binds to the NavigationViewItem's Foreground
                     (NavigationViewItemForeground / …PointerOver / …Selected), which
                     gives proper light/dark tinting and hover/selected states for
                     free — what ImageIcon and BitmapIcon couldn't deliver for
                     stroke-only Lucide SVGs. Font file: Assets/Fonts/lucide.ttf;
                     codepoints from lucide-static info.json. -->
                <muxc:NavigationViewItem x:Name="NavRepository" Tag="repository" Content="Dashboard">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE0F5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavPackages" Tag="packages" Content="Packages">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE129;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavManifests" Tag="manifests" Content="Manifests">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE0CC;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavCatalogs" Tag="catalogs" Content="Catalogs">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE100;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavIcons" Tag="icons" Content="Icons">
                    <muxc:NavigationViewItem.Icon>
                        <!-- Placeholder. OnNavViewLoaded swaps the Viewbox.Child for a
                             stroked Lucide image Path so the stroke weight matches
                             the rest of the rail exactly. -->
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE100;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavGit" Tag="git" Content="Git">
                    <muxc:NavigationViewItem.Icon>
                        <!-- Placeholder. The actual icon is injected in
                             MainWindow.OnNavViewLoaded as a stroked Path so it
                             matches the title-bar GitIndicator exactly — the
                             Lucide font glyph rendered visibly thinner at small
                             sizes than the title bar's 2px-stroked Path. -->
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE0E2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavImport" Tag="import" Content="Import">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE0B2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavBuild" Tag="build" Content="Build">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE0EC;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem x:Name="NavSettings" Tag="settings" Content="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/lucide.ttf#lucide" Glyph="&#xE154;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
