<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CimianStudio.Views.Build.BuildPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:build="using:CimianStudio.Views.Build">

    <!-- Matches the Packages/Catalogs page layout: outer Grid with consistent
         page padding + ColumnSpacing, each column wrapped in a CardStyle Border
         with the shared CardShadow + Translation depth, so the Build tab reads
         the same as the rest of the app. -->
    <Grid Padding="16,12,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="280" MinWidth="220" MaxWidth="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Shadow="{StaticResource CardShadow}"
                Translation="0,0,16">
        <Grid Padding="16,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="Build" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock x:Name="ProjectCountText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Initializing…" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="FilterBox"
                         PlaceholderText="Filter projects…"
                         TextChanged="OnFilterChanged" />
                <Button Grid.Column="1"
                        x:Name="NewProjectButton"
                        Click="OnNewProjectClicked"
                        ToolTipService.ToolTip="Scaffold a new cimipkg project (cimipkg --create)"
                        Padding="8,4">
                    <Viewbox Width="14" Height="14">
                        <Path Width="24" Height="24" Style="{StaticResource LucidePath}"
                              Data="M12,5 V19 M5,12 H19" />
                    </Viewbox>
                </Button>
            </Grid>

            <ListView Grid.Row="2"
                      x:Name="ProjectListView"
                      SelectionMode="Single"
                      SelectionChanged="OnProjectSelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,6,8,6" />
                        <Setter Property="MinHeight" Value="32" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Build" Click="OnContextBuildClicked" />
                        <MenuFlyoutItem Text="Reveal in File Explorer" Click="OnContextRevealClicked" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Rename…" Click="OnContextRenameClicked" />
                        <MenuFlyoutItem Text="Duplicate" Click="OnContextDuplicateClicked" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete…" Click="OnContextDeleteClicked" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
        </Grid>
        </Border>

        <!-- Right: project detail wrapped in its own card for shadow/depth
             matching the Packages/Catalogs pattern. Action bar pinned; the
             scrollable area holds the per-section Build Info / Payload / Scripts
             surfaces. -->
        <Border Grid.Column="1"
                Style="{StaticResource CardStyle}"
                Shadow="{StaticResource CardShadow}"
                Translation="0,0,16">
        <Grid Padding="16,16,16,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Action bar -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="ProjectNameText"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               Text="No project selected" />
                    <TextBlock x:Name="ActionStatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="ResignButton"
                        Content="Re-sign .pkg…"
                        Click="OnResignClicked"
                        ToolTipService.ToolTip="Re-sign an existing .pkg without rebuilding (cimipkg --resign)" />
                <Button Grid.Column="2"
                        x:Name="RevealProductButton"
                        Content="Reveal Built Package"
                        Visibility="Collapsed"
                        Click="OnRevealProductClicked" />
                <Button Grid.Column="3"
                        x:Name="ImportProductButton"
                        Content="Import into Repo"
                        Visibility="Collapsed"
                        Click="OnImportProductClicked" />
                <Button Grid.Column="4"
                        x:Name="OptionsButton"
                        Content="Options"
                        Click="OnOptionsClicked"
                        IsEnabled="False" />
                <Button Grid.Column="5"
                        x:Name="BuildButton"
                        Content="Build Package"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnBuildClicked"
                        IsEnabled="False" />
            </Grid>

            <!-- Scrolling content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <!-- Empty-state placeholder for the unconfigured-folder case. -->
                    <Border x:Name="NoProjectsFolderPanel"
                            Visibility="Collapsed"
                            Style="{StaticResource CardStyle}"
                            Padding="20,18,20,18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="No projects folder configured"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Open Settings → Build and pick the folder that contains your cimipkg projects (one project per subdirectory)."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <HyperlinkButton Content="Open Settings" Click="OnOpenSettingsClicked" Padding="0" />
                        </StackPanel>
                    </Border>

                    <!-- Build console — hidden until a build has emitted output. -->
                    <Border x:Name="ConsoleBorder"
                            Visibility="Collapsed"
                            Style="{StaticResource CardStyle}"
                            Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="200" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Build output"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Clear"
                                        Click="OnClearConsoleClicked" />
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="ConsoleScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ConsoleText"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12"
                                               TextWrapping="NoWrap"
                                               Padding="10"
                                               IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Build Info: three-column typed form for the day-to-day fields,
                         with an Advanced expander below holding the rarely-used MSI /
                         metadata extras. Mirrors the cimipkg build-info.yaml schema. -->
                    <Border x:Name="BuildInfoBorder"
                            Style="{StaticResource CardStyle}"
                            Padding="16"
                            Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Build Info"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid x:Name="BuildInfoGrid" ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="ColPackage"  Grid.Column="0" Spacing="8" />
                                <StackPanel x:Name="ColOptions"  Grid.Column="1" Spacing="8" />
                                <StackPanel x:Name="ColSigning"  Grid.Column="2" Spacing="8" />
                            </Grid>
                            <!-- Advanced is wired up and routed by PopulateBuildInfoForm but
                                 hidden from the UI for now — the day-to-day three columns
                                 cover everything most projects need. Flip this Visibility
                                 to "Visible" to surface it again. -->
                            <Expander x:Name="AdvancedExpander"
                                      Header="Advanced"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="ColAdvancedPackage" Grid.Column="0" Spacing="8" />
                                    <StackPanel x:Name="ColAdvancedInstall" Grid.Column="1" Spacing="8" />
                                    <StackPanel x:Name="ColAdvancedMsi"     Grid.Column="2" Spacing="8" />
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Payload + Scripts (50/50). -->
                    <Grid x:Name="PayloadScriptsGrid" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Payload -->
                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Payload"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Win11 File Explorer-style command bar buttons:
                                         Segoe Fluent Icons glyph + label. Glyphs:
                                           E8F4 NewFolder
                                           E710 Add
                                           E74D Delete
                                           E838 FolderOpen
                                           E740 FullScreen (stand-in for Expand All) -->
                                    <Button Click="OnPayloadNewFolderClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8F4;" />
                                            <TextBlock Text="New Folder" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnPayloadAddFilesClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Glyph="&#xE710;" />
                                            <TextBlock Text="Add Files" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnPayloadDeleteClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Glyph="&#xE74D;" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnPayloadRevealClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Glyph="&#xE838;" />
                                            <TextBlock Text="Reveal" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PayloadExpandToggle"
                                            Visibility="Collapsed"
                                            Click="OnPayloadExpandToggleClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="PayloadExpandIcon"
                                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Glyph="&#xE73F;" />
                                            <TextBlock x:Name="PayloadExpandLabel" Text="Collapse" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <muxc:TreeView x:Name="PayloadTree"
                                               MaxHeight="480"
                                               AllowDrop="True"
                                               DragOver="OnPayloadDragOver"
                                               Drop="OnPayloadDrop"
                                               DoubleTapped="OnPayloadDoubleTapped"
                                               RightTapped="OnPayloadRightTapped"
                                               SelectionMode="Single">
                                    <muxc:TreeView.ItemTemplate>
                                        <!-- ItemsSource-mode binding: each row's DataContext
                                             is a PayloadTreeNode and TreeViewItem.ItemsSource
                                             walks its Children for the hierarchy. RootNodes
                                             mode ignores ItemTemplate, which is why earlier
                                             attempts showed only chevrons. -->
                                        <DataTemplate x:DataType="build:PayloadTreeNode">
                                            <!-- IsExpanded="True" so the tree shows
                                                 every folder open by default — payload
                                                 trees are typically small and admins
                                                 want to see structure at a glance. -->
                                            <muxc:TreeViewItem ItemsSource="{x:Bind Children}"
                                                               IsExpanded="True">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                              FontSize="14"
                                                              Glyph="{x:Bind Glyph}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Name}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </muxc:TreeViewItem>
                                        </DataTemplate>
                                    </muxc:TreeView.ItemTemplate>
                                </muxc:TreeView>
                            </StackPanel>
                        </Border>

                        <!-- Scripts -->
                        <Border Grid.Column="1"
                                Style="{StaticResource CardStyle}"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Scripts"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel x:Name="ScriptsPanel" Spacing="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Border>
    </Grid>
</Page>
