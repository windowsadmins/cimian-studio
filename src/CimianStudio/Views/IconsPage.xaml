<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CimianStudio.Views.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:icons="using:CimianStudio.Core.Models.Icons"
    xmlns:local="using:CimianStudio.Views">

    <Grid Padding="16,12,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Shadow="{StaticResource CardShadow}"
                Translation="0,0,16">
            <Grid Padding="16,12,16,16" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Icons"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RebuildButton"
                            Click="OnRebuildClicked"
                            IsEnabled="{x:Bind ViewModel.CanRebuild, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                <!-- Lucide refresh-cw -->
                                <Path Width="24" Height="24"
                                      Style="{StaticResource LucidePath}"
                                      Data="M21,12 A9,9 0 1 1 18.4,5.4 L21,8 M21,3 V8 H16" />
                            </Viewbox>
                            <TextBlock Text="Rebuild hashes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <muxc:ProgressRing IsActive="{x:Bind ViewModel.IsRebuilding, Mode=OneWay}"
                                       Width="20" Height="20"
                                       VerticalAlignment="Center" />
                </StackPanel>

                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Icons, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedIcon, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="icons:IconAsset">
                            <Grid Padding="0,4,0,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                    <!-- Lucide image -->
                                    <Path Width="24" Height="24"
                                          Style="{StaticResource LucidePath}"
                                          Data="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M7,9 A2,2 0 1 0 11,9 A2,2 0 1 0 7,9 Z M21,15 L17.914,11.914 A2,2 0 0 0 15.086,11.914 L6,21" />
                                </Viewbox>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Filename}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind local:IconsPage.FormatByteSize(ByteSize)}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <InfoBar Grid.Row="3"
                         x:Name="StatusBar"
                         IsClosable="True"
                         IsOpen="False" />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource CardStyle}"
                Shadow="{StaticResource CardShadow}"
                Translation="0,0,16">
            <Grid x:Name="DetailRoot" Padding="24" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <muxc:ProgressRing x:Name="PreviewProgress"
                                       IsActive="False"
                                       Width="32" Height="32" />
                    <Image x:Name="PreviewImage"
                           MaxWidth="280" MaxHeight="280"
                           Stretch="Uniform" />
                    <TextBlock x:Name="EmptyHint"
                               Text="Select an icon to preview it."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock x:Name="DetailNameText"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailSizeText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="DetailHashText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
