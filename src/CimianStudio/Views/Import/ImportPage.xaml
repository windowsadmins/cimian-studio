<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CimianStudio.Views.Import.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CimianStudio.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="Import"
                           Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Drop installer files (MSI / EXE / MSIX / NUPKG) below or pick them. CimianStudio runs cimiimport.exe for each file with the options you set — name, version, developer, catalogs, etc. come from the installer itself and can be tweaked afterward in the Package Editor."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Tool-missing banner. Visible when cimiimport.exe can't be located. -->
            <InfoBar Grid.Row="1"
                     x:Name="ToolMissingBar"
                     IsClosable="False"
                     IsOpen="False"
                     Severity="Warning"
                     Title="cimiimport.exe not found"
                     Message="Install Cimian or set the path in Settings → Import." />

            <!-- Drop zone -->
            <Border Grid.Row="2"
                    x:Name="DropZone"
                    Style="{StaticResource CardStyle}"
                    Shadow="{StaticResource CardShadow}"
                    Translation="0,0,16"
                    AllowDrop="True"
                    DragOver="OnDropZoneDragOver"
                    Drop="OnDropZoneDrop"
                    MinHeight="160">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Viewbox Width="40" Height="40">
                        <Path Width="24" Height="24" Style="{StaticResource LucidePath}"
                              Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                              Data="M21,15 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V15 M17,8 L12,3 L7,8 M12,3 V15" />
                    </Viewbox>
                    <TextBlock Text="Drop installer files here, or…"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Button x:Name="PickFileButton"
                            Content="Pick installer files…"
                            HorizontalAlignment="Center"
                            Click="OnPickFileClicked" />
                </StackPanel>
            </Border>

            <!-- Queue + per-file status -->
            <Border Grid.Row="3"
                    x:Name="QueueBorder"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Queue"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Clear"
                                Click="OnClearQueueClicked" />
                    </Grid>
                    <ListView x:Name="QueueListView"
                              ItemsSource="{x:Bind ViewModel.Queue}"
                              SelectionMode="None"
                              MaxHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6,4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            FontSize="10"
                                            MinWidth="26"
                                            MinHeight="26"
                                            Padding="0"
                                            Click="OnRemoveQueueItemClicked"
                                            Tag="{Binding FilePath}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- cimiimport options -->
            <Border Grid.Row="4"
                    x:Name="OptionsBorder"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="cimiimport options"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Applied to every file in the queue. Anything not set falls back to cimiimport's defaults / autodetection."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Architecture override (--arch)" Style="{StaticResource CaptionTextBlockStyle}" />
                            <ComboBox x:Name="ArchCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="(auto-detect)" Tag="" IsSelected="True" />
                                <ComboBoxItem Content="x64" Tag="x64" />
                                <ComboBoxItem Content="arm64" Tag="arm64" />
                                <ComboBoxItem Content="x64,arm64" Tag="x64,arm64" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Uninstaller path (--uninstaller)" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UninstallerBox" PlaceholderText="(none)" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnPickUninstallerClicked" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Minimum OS version (--minimum_os_version)" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBox x:Name="MinOsBox" PlaceholderText="e.g. 10.0.19041" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Maximum OS version (--maximum_os_version)" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBox x:Name="MaxOsBox" PlaceholderText="(none)" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Minimum Cimian version (--minimum_cimian_version)" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBox x:Name="MinCimianBox" PlaceholderText="(none)" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <CheckBox x:Name="ExtractIconCheck" Content="Extract icon (--extract-icon)" />
                        </StackPanel>
                    </Grid>

                    <Expander Header="Scripts" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Provide paths to PowerShell script files. cimiimport reads each and embeds it in the produced pkginfo."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="ScriptsPanel" Spacing="6" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Run + console + result -->
            <Border Grid.Row="5"
                    x:Name="RunBorder"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RunStatusText"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                x:Name="RunButton"
                                Content="Run cimiimport"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnRunClicked"
                                IsEnabled="False" />
                    </Grid>
                    <Border x:Name="ConsoleBorder"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <ScrollViewer x:Name="ConsoleScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Height="200">
                            <TextBlock x:Name="ConsoleText"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12"
                                       TextWrapping="NoWrap"
                                       Padding="10"
                                       IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel x:Name="ResultActionsPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                        <Button x:Name="OpenInPackageEditorButton"
                                Content="Open most-recent pkginfo in Package Editor"
                                Click="OnOpenInPackageEditorClicked" />
                        <Button x:Name="OpenInGitButton"
                                Content="Commit imports in Git tab"
                                Click="OnOpenInGitClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
