<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CimianStudio.Infrastructure</RootNamespace>
    <AssemblyName>CimianStudio.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CimianStudio.Core\CimianStudio.Core.csproj" />
    <ProjectReference Include="..\CimianStudio.Shared\CimianStudio.Shared.csproj" />
    <!-- CimianStudio is a standalone GitHub repo (github.com/windowsadmins/cimianstudio).
         It deliberately does NOT type-couple to the Cimian source repo — admins
         are expected to have Cimian installed (cimipkg.exe + cimiimport.exe at
         C:\Program Files\Cimian\). The Build and Import tabs shell out to those
         binaries at runtime via Process.Start. YAML round-tripping lives locally
         in Yaml/CimianYaml.cs, ported from the upstream YamlUtils — the on-disk
         pkginfo/manifest/catalog format is the contract, not the .cs source. -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CimianStudio.Infrastructure.Tests" />
  </ItemGroup>
</Project>
